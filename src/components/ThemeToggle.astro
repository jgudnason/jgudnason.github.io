---
// Light/dark switch. Choice is stored in localStorage; with no stored choice the
// OS preference wins (see the inline script in BaseLayout).
---

<button
  id="theme-toggle"
  type="button"
  class="rounded border border-subtle px-2 py-1 text-sm font-medium text-slate-600 hover:border-accent hover:text-accent dark:text-slate-300"
  aria-label="Switch between light and dark mode"
>
  <span class="dark:hidden">Dark</span>
  <span class="hidden dark:inline">Light</span>
</button>

<script>
  const toggle = document.getElementById("theme-toggle");

  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
