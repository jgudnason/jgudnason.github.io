---
import type { CollectionEntry } from "astro:content";
import { site } from "../data/site";

interface Props {
  publication: CollectionEntry<"publications">;
}

const { publication } = Astro.props;
const { title, authors, journal, year, doi, pdfUrl } = publication.data;

/** The site owner's own name is emphasised in the author list. */
const surname = site.name.split(" ").at(-1)!;
---

<article class="border-b border-subtle py-5 first:pt-0 last:border-b-0">
  <h3 class="mt-0 mb-2 text-lg">{title}</h3>

  <p class="m-0 font-sans text-sm text-slate-700 dark:text-slate-300">
    {
      authors.map((author, index) => (
        <>
          <span class:list={[author.includes(surname) && "font-semibold"]}>{author}</span>
          {index < authors.length - 1 && ", "}
        </>
      ))
    }
  </p>

  <p class="mt-1 mb-0 font-sans text-sm text-slate-600 italic dark:text-slate-400">
    {journal}, {year}
  </p>

  {
    (doi || pdfUrl) && (
      <ul class="mt-3 mb-0 flex list-none flex-wrap gap-x-4 gap-y-1 p-0">
        {doi && (
          <li class="font-mono text-xs">
            <a href={`https://doi.org/${doi}`} rel="noopener">
              doi:{doi}
            </a>
          </li>
        )}
        {pdfUrl && (
          <li class="font-mono text-xs">
            <a href={pdfUrl}>PDF</a>
          </li>
        )}
      </ul>
    )
  }
</article>
