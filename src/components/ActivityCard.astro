---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../utils/date";

interface Props {
  activity: CollectionEntry<"activities">;
}

const { activity } = Astro.props;
const { title, pubDate, description, category, tags } = activity.data;
---

<article class="border-b border-subtle py-6 first:pt-0 last:border-b-0">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-sm">
    <span
      class="rounded border border-subtle px-2 py-0.5 font-medium text-slate-600 dark:text-slate-300"
    >
      {category}
    </span>
    <time datetime={pubDate.toISOString()} class="text-slate-600 dark:text-slate-400">
      {formatDate(pubDate)}
    </time>
  </div>

  <h3 class="mt-3 mb-0 text-xl">
    <a href={`/activities/${activity.id}/`} class="no-underline hover:underline">{title}</a>
  </h3>

  <p class="mt-2 mb-0 text-slate-700 dark:text-slate-300">{description}</p>

  {
    tags.length > 0 && (
      <ul class="mt-3 mb-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0">
        {tags.map((tag) => (
          <li class="font-mono text-xs text-slate-600 dark:text-slate-400">#{tag}</li>
        ))}
      </ul>
    )
  }
</article>
