---
import ThemeToggle from "./ThemeToggle.astro";
import { navItems, site } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

/** A nav item is current for its own page and for anything nested under it. */
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="border-b border-subtle">
  <div
    class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-4"
  >
    <a href="/" class="text-lg font-bold no-underline">{site.name}</a>

    <nav aria-label="Main" class="flex items-center gap-x-5 gap-y-2">
      <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0">
        {
          navItems.map((item) => (
            <li class="text-base">
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class:list={[
                  "font-medium no-underline",
                  isCurrent(item.href)
                    ? "text-accent underline decoration-2 underline-offset-4"
                    : "text-slate-600 hover:text-accent dark:text-slate-300",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>
