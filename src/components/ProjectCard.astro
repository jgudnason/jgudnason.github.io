---
interface Props {
  title: string;
  description: string;
  /** Optional project, lab or grant page. */
  url?: string;
  /** Short labels: methods, funding source, or partner type. */
  tags?: string[];
  /** Named partners or labs, rendered as a single line of context. */
  partners?: string;
}

const { title, description, url, tags = [], partners } = Astro.props;
---

<article class="rounded-lg border border-subtle p-5">
  <h3 class="mt-0 mb-0 text-lg">
    {url ? <a href={url} class="no-underline hover:underline">{title}</a> : title}
  </h3>

  <p class="mt-2 mb-0 text-slate-700 dark:text-slate-300">{description}</p>

  {
    partners && (
      <p class="mt-2 mb-0 font-sans text-sm text-slate-600 dark:text-slate-400">{partners}</p>
    )
  }

  {
    tags.length > 0 && (
      <ul class="mt-3 mb-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0">
        {tags.map((tag) => (
          <li class="font-mono text-xs text-slate-600 dark:text-slate-400">{tag}</li>
        ))}
      </ul>
    )
  }
</article>
